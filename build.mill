//| mill-version: 1.1.10
//| mvnDeps:
//| - com.goyeau::mill-scalafix::0.6.2
//| - com.lihaoyi::mill-contrib-versionfile:$MILL_VERSION

package build

import mill.*, scalalib.*
import mill.contrib.versionfile.VersionFileModule
import com.goyeau.mill.scalafix.ScalafixModule

object versionFile extends VersionFileModule {
  override def moduleDir = super.moduleDir / os.up
}

trait ModCore extends ScalaModule with ScalafixModule {
  override def scalaVersion = "3.9.0"

  override def scalacOptions = Seq(
    "-Wunused:all",
    "-deprecation",
  )

  override def sources = Task {
    super.sources() :+ realitylink.source()
  }

  override def mvnDeps = Task {
    super.mvnDeps() ++ Seq(
      mvn"org.typelevel::cats-effect:3.7.1",
      mvn"org.slf4j:slf4j-api:2.0.20",
      mvn"org.typelevel::log4cats-slf4j:2.8.0",
      mvn"com.indoorvivants::toml:0.3.0",
      mvn"io.circe::circe-core:0.14.16",
      mvn"io.circe::circe-generic:0.14.16",
      mvn"io.circe::circe-parser:0.14.16",
      mvn"co.fs2::fs2-core:3.14.0",
      mvn"co.fs2::fs2-io:3.14.0",
      mvn"de.lhns::fs2-compress-zip:3.0.1",
      mvn"org.http4s::http4s-ember-server:0.23.38",
      mvn"org.http4s::http4s-ember-client:0.23.38",
      mvn"org.http4s::http4s-dsl:0.23.38",
      mvn"org.http4s::http4s-circe:0.23.38",
    )
  }
}

object realitylink extends Module {
  def source: Task[PathRef] = Task.Source("src")
}
